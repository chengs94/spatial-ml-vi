# Internal functions  #
#######################
'%!in%' <- function(x,y)!('%in%'(x,y))
expit <- function(x){
exp(x)/(1+exp(x))
}
## Generates "Covariance" Matrices for TPRS
makeSigmaTPRS <- function (pars, coords1, coords2=coords1, basis.coords=coords1,
m=2, fit.tprs=TRUE, out.ZB=FALSE,
K=nrow(basis.coords), pen.form=FALSE) {
## Just constructs one block at a time
## pars is just a scalar, the sill
## m = parameter in TPRS Smooth (m=2 is for cubic splines)
## fit.tprs = TRUE indicates that the output is for ESTIMATION TPRS PARAMETERS,
##				i.e. SigmaB = U_k D_k W_k (W_k' D_k W_k)^{-1} W_k' D_k' U_k'
##			= FALSE indicates that the output is for PREDICTION USING TPRS
##				i.e. SigmaB = E U_k W_k (W_k' D_k W_k)^{-1} W_k' U_k' E'
## where E is dim nrow(coords2) by nrow(coords1)
## U_k is dim nrow(coords1) by nrow(coordsK)
## W_k is dim nrow(coordsK) by nrow(coordsK)-M
## gen.new means we generate for a new set of observations.
## i.e. when fit.tprs=FALSE and gen.new=TRUE then output
##	E2 <- eta.func(r=crossDist(coords2, coords1), d=2, m=m)
##	SigmaTPRS = E2%*%Uk%*%Zk%*%O%*%t(O)%*%t(Zk)%*%t(Uk)%*%t(E2)*pars
##	Otherwise, output
##	SigmaTPRS = E%*%Uk%*%Zk%*%O%*%t(O)%*%t(Zk)%*%t(Uk)%*%t(E2)*pars
## Note that the eigen decompostion is ALWAYS based on coords1
## NOTE: Assumes that T is in LUR already, based on createSTmodel3
if(fit.tprs & nrow(coords1) != nrow(coords2)){
print("When fitting TPRS, require coords1 == coords2")
stop
}
T <- cbind(1, basis.coords)
colnames(T) <- c("Int", "x.beta", "y.beta")
if(m > 2){
for(jj in 2:(m-1)){
temp.T <- coords1^jj
colnames(temp.T) <- c(paste("x.beta", jj, sep=""), paste("y.beta", jj, sep=""))
T <- cbind(T, temp.T)
rm(temp.T)
}
}
T <- as.matrix(T)
M <- choose(m+2-1, 2) #d=2
E <- .etaFunc(r=crossDist(basis.coords), d=2, m=m)
Ek <- eigen(E)
Uk <- Ek$vectors[, 1:K]
Dk <- diag(Ek$values[1:K])
tUkT <- t(Uk)%*%T
QR <- qr(tUkT)
Zk <- qr.Q(QR, complete=TRUE)[, (M+1):K]
O <- t(Zk)%*%Dk%*%Zk
O <- svd(O)
O$d <- sqrt(O$d)
O <- solve(O$u%*%diag(O$d)%*%t(O$v))
if(!pen.form){
if(fit.tprs){
SigmaTPRS = Uk%*%Dk%*%Zk%*%O
if(!out.ZB){
SigmaTPRS = SigmaTPRS%*%t(SigmaTPRS)*pars
}
} else {
E1 <- .etaFunc(r=crossDist(coords1, basis.coords), d=2, m=m)
E2 <- .etaFunc(r=crossDist(coords2, basis.coords), d=2, m=m)
SigmaTPRS = E2%*%Uk%*%Zk%*%O
if(!out.ZB){
SigmaTPRS = SigmaTPRS%*%O%*%t(Zk)%*%t(Uk)%*%t(E1)*pars
}
}
return(SigmaTPRS)
}
}
### calculates predictions for a new x under by kriging
predict.cor <- function(f,eps,theta,R.test,R=NULL,i.sig=NULL){
if(is.null(i.sig)){
nugget <- ifelse(length(theta) ==2,theta[2],1-theta[1])
i.sig <- fast.solve( theta[1] * R + nugget * diag( rep ( 1, dim(R)[1] ) ) )
}
f + theta[1] * R.test %*% i.sig %*% eps
}
### Cleans GIS covariates
### Removes covariates with missing value or which are constant
### Additionally removes common GIS covariates that are not to be included
### If rm.outliers, removes covariates in accordance with Keller 2014
cleanGIS <- function(X,X.test=NULL,rm.outliers=FALSE){
if( !is.null(X.test) ){
if(any(colnames(X) != colnames(X.test))) {
stop("X and X.test must have same covariates")
}
X.test <- as.matrix(X.test)
}
X.out <- as.matrix(X)
remove1 <- as.numeric(unique(which(is.na(X.out),arr.ind=T)[,2]))
if(length(remove1) > 0){
X.out <- X.out[,-remove1]
if(!is.null(X.test)){
X.test <- X.test[,-remove1]
}
}
remove2 <- which(colnames(X.out) %in% c("native_id","location_id","latitude",
"longitude","lambert_x","lambert_y",
"state_plane","state","county"))
if(length(remove2) > 0){
X.out <- X.out[,-remove2]
if(!is.null(X.test)){
X.test <- X.test[,-remove2]
}
}
remove3 <- which(apply(as.matrix(X.out),2,sd)==0)
if(length(remove3) > 0){
X.out <- X.out[,-remove3]
if(!is.null(X.test)){
X.test <- X.test[,-remove3]
}
}
if(rm.outliers){
## Clean GIS covariates in accordance with Keller, 2014 for PCA/PLS
# Remove any variable which have >80% same values
max.repeat <- rep(NA, dim(X.out)[2])
for(i in 1:dim(X.out)[2]){
max.repeat[i] <- max(table(X.out[, i]))
}
rmv2 <- which(max.repeat>=(0.8*(dim(X.out)[1])))
if(length(rmv2) > 0){
X.out <- X.out[,-rmv2]
if(!is.null(X.test)){
X.test <- X.test[,-rmv2]
}
}
# Remove geogrphic coordinates with >2% more than 5 sd from the mean
num.5sd <- rep(NA,dim(X.out)[2])
for(i in 1:dim(X.out)[2]){
cmean <- mean(X.out[,i])
sdmean <- sd(X.out[,i])
ll <- cmean - 5* sdmean
ul <- cmean + 5 * sdmean
num.5sd[i] <- length(which(X.out[,i]>= ul | X.out[,i] <= ll))
}
rmv3 <- which(num.5sd >= 0.02 * dim(X.out)[1])
if(length(rmv3) > 0){
X.out <- X.out[,-rmv3]
if(!is.null(X.test)){
X.test <- X.test[,-rmv3]
}
}
}
out <- list(X=X.out)
if(!is.null(X.test)){
out$X.test <- X.test
}
return(out)
}
### Calculates R2
get.r2 <- function(y,y.hat){
if(is.matrix(y)) {
if(dim(y)[2]>1){
if(dim(y)[1]!=dim(y.hat)[1] | dim(y)[2]!=dim(y.hat)[2]) stop("y, y.hat must have the same dimensions!")
out <- rep(NA,dim(y)[2])
for (a in 1:length(out)){
ya <- y[,a]
n<-sum(!is.na(ya))
Ee2 <- sum((ya-y.hat[,a])^2,na.rm=T)/n
out[a] <- round(max(0,1-Ee2/var(ya,na.rm=T)),3)
}
} else{
n<-sum(!is.na(y))
Ee2 <- sum((y-y.hat)^2,na.rm=T)/n
out <- round(max(0,1-Ee2/var(y,na.rm=T)),3)
}
} else{
n<-sum(!is.na(y))
Ee2 <- sum((y-y.hat)^2,na.rm=T)/n
out <- round(max(0,1-Ee2/var(y,na.rm=T)),3)
}
out
}
#################
# PC Regression #
#################
### get.pcs
### Gets principal components by PCA/PLS given initial covariates and # PC's
get.pcs <- function(x,method,numpcs,obs.mat=NULL,...){
if(method == "pca"){
obj<- pls::pcr(obs.mat~as.matrix(x), ncomp = numpcs, scale=TRUE,...)
} else if(method=="pls"){
obj<- pls::plsr(obs.mat ~ as.matrix(x), ncomp = numpcs,scale=TRUE,...)
}
new.x <- as.matrix(obj$scores)
proj <- obj$projection
if(numpcs>1) colnames(new.x)<-paste("PC",1:numpcs,sep="")
return(list(X=new.x,proj=proj,loadings=obj$loadings[]))
}
### log.like.exp
### calculates the likelihood for any normal r.v. using exponential covariance
logLikeExp <- function(theta,y,dist.mat,x=NULL,log.scale=TRUE){
nggt <- theta[2]
sll <- theta[1]
range <- theta[3]
if(log.scale){
nggt <- exp(theta[2])
sll <- exp(theta[1])
range <- exp(theta[3])
}
n <- length(y)
obj <- .detInv(c(sll,nggt),exp(-dist.mat/range))
Om <- obj$i.Sig
if(!is.null(x)){
p <- dim(x)[2]
Om <- Om - Om %*% x %*% .fastSolve( t(x) %*% Om %*% x) %*% t(x) %*% Om
}
if(length(theta)==1){
out <- n*log( t(y) %*% Om %*% y/ n) + obj$det.Sig
} else{
out <- obj$det.Sig + t(y) %*% Om %*% y
}
out
}
.detInv <- function(theta,R){
n <- dim(R)[1]
nggt <- ifelse(length(theta) ==2,theta[2],1-theta[1])
i.Sig <- try(chol( theta[1]*R + nggt * diag(rep(1,n))), silent = TRUE)
if(inherits(i.Sig,'try-error') ){
svd.obj <- svd(theta[1]*R + nggt * diag(rep(1,n)))
#SC changed a line here
#svd.obj <- propack.svd(theta[1]*R + nggt * diag(rep(1,n)))
i.Sig <- svd.obj$u %*% diag(1/svd.obj$d) %*% t(svd.obj$v)
det.Sig <-  sum(log(svd.obj$d))
} else{
det.Sig <- 2 * sum ( log ( diag (i.Sig) ) )
i.Sig <- chol2inv(i.Sig)
}
out <- list(i.Sig = i.Sig, det.Sig = det.Sig)
return(out)
}
### cv.pcr
### selects the number of pc's by k-fold cross validation
cv.pcr.exp <- function(x,y,full.dist,pars.init,cv.pcs,
k=10, method = "pca", naive=FALSE,...) {
## Sample x
n <- dim(x)[1]
p <- dim(x)[2]
m <- length(cv.pcs)
MSE <- rep(0, m)
names(MSE) <- cv.pcs
y.full <- matrix(NA,n,m)
colnames(y.full) <- cv.pcs
if(naive){
x.pcs <- vector(mode = "list", length = m)
for ( i in 1:m){
x.pcs[[i]] <- as.matrix(get.pcs(x,method,cv.pcs[i],y)$X)
}
}
smpl <- sample(n)
ind.stop <- round(n/k*1:k)
ind.strt <- c(1,ind.stop[1:k-1]+1)
### For each cross validation fold
for(i in 1:k){
## Break up into training and test set
cv.ind.i <- c(smpl[(ind.strt[i]:ind.stop[i])])
train.y <- y[-cv.ind.i]
test.y <- y[cv.ind.i]
if (!naive){
test.x <- x[cv.ind.i,]
train.x <- x[-cv.ind.i,]
### Check for covariates that don't vary
check.sd <- apply(train.x,2,sd)
if(any(check.sd==0)){
train.x <- train.x[,-which(check.sd==0)]
test.x <- test.x[,-which(check.sd==0)]
}
## Get means and SDs for training set for PC transformations
means <- apply(train.x,2,mean)
mean.matrix<-matrix(rep(means,length(cv.ind.i)),nrow=dim(test.x)[1],ncol=dim(test.x)[2],byrow=T)
sds <- apply(train.x,2,sd)
}
## Build Associated Distance Matrices
R <- full.dist[-cv.ind.i,-cv.ind.i]
R.test <- full.dist[cv.ind.i,-cv.ind.i]
n.train <- length(train.y)
n.test <- length(test.y)
## For each fold, test each number of PC's
for(numpcs in cv.pcs){
if(naive){
x.pcr <- x.pcs[[ which(cv.pcs==numpcs) ]]
train.x.pcr <- x.pcr[-cv.ind.i,]
test.x.pcr <- x.pcr[cv.ind.i,]
} else{
x.pcr <- get.pcs(train.x,method,numpcs,train.y)
train.x.pcr <- x.pcr$X
test.x.pcr <- (test.x - mean.matrix) %*% diag(1/sds) %*% x.pcr$proj
}
theta <- optim(pars.init[,which(cv.pcs==numpcs)],logLikeExp,
method="L-BFGS-B", lower=c(-30,-20,-10),
upper =c(15,15,30), y=train.y,
dist.mat=R, x=train.x.pcr)
i.V <- .fastSolve(exp(theta$par[1]) * exp(-R/exp(theta$par[3])) +
exp(theta$par[2]) * diag(n.train))
beta.hat.pcr <- solve(t(train.x.pcr) %*% i.V %*% train.x.pcr,
t(train.x.pcr) %*% i.V %*% train.y)
y.est <- c(test.x.pcr %*% beta.hat.pcr) +
exp(theta$par[1]) * exp(-R.test / exp(theta$par[3])) %*%
i.V %*% c( train.y - c(train.x.pcr %*% beta.hat.pcr) )
y.full[cv.ind.i,which(colnames(y.full)==numpcs)] <- y.est
MSE[which(names(MSE)==numpcs)] <- sum((test.y-y.est)^2)
}
}
out <- list(mse=MSE/(n),cv.pcs=cv.pcs, y.min = y.full[,which.min(MSE)],
opt.pcs=as.numeric(names(MSE)[which.min(MSE)]))
return(out)
}
