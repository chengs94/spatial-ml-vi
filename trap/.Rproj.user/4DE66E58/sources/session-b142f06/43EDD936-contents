### Difference in grid predictions: spatial RF vs UK-PLS

```{r, fig.width=8, fig.height=6}
library(sf)
library(ggmap)
library(ggplot2)
library(gridExtra)
library(grid)

load("rslt_grid_uw_mean.RData")
grid.bc.uw.mean = grid.bc.uw
grid.ufp.uw.mean = grid.ufp.uw
load("rslt_grid_uw2.RData")
pls.bc.uw.mean = grid.bc.uw
pls.ufp.uw.mean = grid.ufp.uw
load("rslt_grid_uw.RData")
grid.bc.uw$Y.pls.mean = pls.bc.uw.mean$Y.pls.mean
grid.ufp.uw$Y.pls.mean = pls.ufp.uw.mean$Y.pls.mean
grid.bc.uw$Y.pls.cov = pls.bc.uw.mean$Y.pls - pls.bc.uw.mean$Y.pls.mean
grid.ufp.uw$Y.pls.cov = pls.ufp.uw.mean$Y.pls - pls.ufp.uw.mean$Y.pls.mean
project_crs <- 4326
study_area_shp <- read_sf("oval_shp/oval_around_monitoring_area.shp") %>% 
  st_transform(project_crs)

grid_covars_shp <- cov_grid %>%
  st_as_sf(., coords=c("longitude","latitude"), remove = FALSE,
           crs=project_crs)
grid_covars_shp$in_study_area <- st_intersects(grid_covars_shp, study_area_shp,
                                               sparse = FALSE) %>%
  apply(., 1, any)


seaMap <- get_map(location=c(min(cov_grid$longitude), min(cov_grid$latitude),
                             max(cov_grid$longitude), max(cov_grid$latitude)),
                  source="stamen", maptype = "terrain", crop=FALSE)

temp = data.frame(longitude.x = cov_grid$longitude[grid_covars_shp$in_study_area], 
                  latitude.x = cov_grid$latitude[grid_covars_shp$in_study_area],
                  Y.diff.ufp = exp(grid.ufp.uw$Y.spatrf.pl[grid_covars_shp$in_study_area]) - 
                    exp(grid.ufp.uw$Y.pls[grid_covars_shp$in_study_area]),
                  Y.diff.bc = exp(grid.bc.uw$Y.spatrf.pl[grid_covars_shp$in_study_area]) - 
                    exp(grid.bc.uw$Y.pls[grid_covars_shp$in_study_area]))

p1 = ggmap(seaMap) + labs(x = "longitude", y = "latitude") +
  geom_point(data = temp, aes(x = longitude.x, y = latitude.x, 
                              color = Y.diff.ufp)) + #size = Y.pls
  scale_color_gradient2(mid = "white", name = "") +
  ggtitle("UFP") + guides(size = FALSE) +
  theme(plot.margin=unit(rep(0,4), "pt"), 
        text = element_text(size = 16))

p2 = ggmap(seaMap) + labs(x = "longitude", y = "latitude") +
  geom_point(data = temp, aes(x = longitude.x, y = latitude.x, 
                              color = Y.diff.bc)) + #size = Y.pls
  scale_color_gradient2(mid = "white", name = "") +
  ggtitle("BC") + guides(size = FALSE) +
  theme(plot.margin=unit(rep(0,4), "pt"), 
        text = element_text(size = 16))

grid.arrange(arrangeGrob(p1, p2, nrow=1),
               top = textGrob("Difference in predictions: SpatRF vs UK-PLS", 
                              gp=gpar(fontsize=20,font=3)))
```

