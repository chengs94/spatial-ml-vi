    imp.spatrf[,1] = imp.spatrf[,1] + 
      rslt.all[[num]][[j]]$spatrf.cv.obj$spatRF.lklhd$var.imp
    #imp.pca.spatrf[,2] = imp.pca.spatrf[,2] + 
