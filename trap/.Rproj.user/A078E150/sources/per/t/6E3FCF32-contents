    imp.rf[,1] = imp.rf[,1] + rslt.ts.all[[num]][[j]]$rf.imp[,1]
    imp.rf[,2] = imp.rf[,2] + rslt.ts.all[[num]][[j]]$tprs.rf.imp[,1]
