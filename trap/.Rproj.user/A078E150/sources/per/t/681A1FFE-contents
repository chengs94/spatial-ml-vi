#           nrow = 1, ncol = 5, common.legend = FALSE, legend = "bottom") %>%
#   annotate_figure(top = text_grob("Annual Average Pollutant Concentration, Seattle", 
#                                   face = "bold", size = 16))

ggarrange(p_ufp, p_pm25, 
          nrow = 1, ncol =2, common.legend = FALSE, legend = "bottom") %>%
  annotate_figure(top = text_grob("Annual Average Pollutant Concentration, Seattle", 
                                  face = "bold", size = 16))
