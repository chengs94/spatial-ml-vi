                  y.true = NULL, coords = latlon, plot.title = "Y (mean)",
                  plot.range = range(y.mean - min(y.mean + y.err$y.sill + y.err$y.nug)))
p.psill = make_plot(use.residual = FALSE, transformed = "none", 
